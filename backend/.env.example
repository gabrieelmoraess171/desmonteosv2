PORT=3001
# Opcional: se definido, /api/vendas/manual e /api/vendas/import exigem
# Authorization: Bearer <token>
API_TOKEN=

# Opcional: chave do Google AI Studio para sugestões de resposta no Atendimento.
# Sem a chave (ou se a API falhar), o backend usa uma sugestão local baseada na ficha da peça.
GEMINI_KEY=
# Modelo usado para gerar as sugestões. Padrão: gemini-3.5-flash
# O backend tenta automaticamente um modelo de reserva se este falhar.
GEMINI_MODEL=gemini-3.5-flash

# Opcional: FreeLLMAPI como provedor principal (agrega vários provedores gratuitos).
# Preencha FREELLMAPI_KEY com a unified key do dashboard (freellmapi-...).
# Se a chave ficar vazia, o backend continua usando o Gemini direto.
FREELLMAPI_URL=http://127.0.0.1:3002/v1
FREELLMAPI_KEY=
# Modelo estável recomendado; "auto" pode demorar ou travar em alguns provedores.
FREELLMAPI_MODEL=gemini-3.1-flash-lite

# Mercado Livre — aplicativo criado em developers.mercadolivre.com.br
# Você também pode salvar Client ID/Secret pela tela Marketplaces.
# Valores definidos no .env têm prioridade sobre os salvos pelo painel.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Deve ser idêntica à Redirect URI cadastrada no aplicativo.
# NÃO use localhost/127.0.0.1: o Mercado Livre bloqueia com 403 (CloudFront).
# No Render, pode ficar vazia para usar RENDER_EXTERNAL_URL automaticamente.
# Para este deploy, cadastre também esta URL no aplicativo do Mercado Livre:
ML_REDIRECT_URI=https://desmonteos-backend.onrender.com/api/mercadolivre/oauth/callback
ML_SITE_ID=MLB
# URL do frontend para onde o callback OAuth redireciona.
FRONTEND_URL=https://desmonteos.onrender.com
# URL HTTPS pública do backend, usada nas fotos ao publicar anúncios novos.
BACKEND_PUBLIC_URL=https://desmonteos-backend.onrender.com
# Opcional: segredo para validar o webhook (?secret= ou header x-ml-webhook-secret).
ML_WEBHOOK_SECRET=
# Opcional: URL pública exibida na tela Marketplaces (ex.: túnel ngrok/cloudflared).
ML_WEBHOOK_URL=
# Opcional: use um mock local para testes. O padrão é a API real.
# ML_API_BASE=https://api.mercadolibre.com
